# SEKRETY (klucze API, hasla): na produkcji (Windows) NIE trzymaj ich jawnie - dopisz tu jak zwykle,
# potem `node scripts/sekrety.js zaszyfruj` przeniesie je do .env.dpapi (DPAPI). Patrz CLAUDE.md "Sekrety".

# Polaczenie do bazy SQL Server Subiekta GT (odczyt do testow GtBridge / sync produktow)
GT_SQL_HOST=192.168.0.200
GT_SQL_PORT=49951
GT_SQL_DATABASE=Z_KAJTEK_IdeaERP
GT_SQL_USER=sa
GT_SQL_PASSWORD=

# Job rozjazdow GT vs WMS (services/rozjazdy.js) - scala kopie WMS K4 do stanu GT.
# ROZJAZDY_INTERWAL_MIN - co ile minut przebieg (domyslnie 10). K4 = zywa sprzedaz,
#   wiec krotszy interwal = mniejsze okno rozjazdu, kosztem czestszych zapytan do GT.
ROZJAZDY_INTERWAL_MIN=10

# Job odswiezania KOPII kartoteki GT w WMS (services/kartoteka.js) - symbol/nazwa/EAN
# w stany_lokalizacji. Kopia starzeje sie po cichu, gdy ktos zmieni symbol w Subiekcie
# (tw_Id jest niezmienne, symbol nie). WMS_KARTOTEKA_INTERWAL_MIN - co ile minut przebieg
# (domyslnie 1440, czyli raz na dobe; pierwszy 2 min po starcie). Towar dotkniety skanem
# naprawia sie od razu, job jest dla calej reszty asortymentu.
WMS_KARTOTEKA_INTERWAL_MIN=1440

# Srodowisko testowe - szary pasek "TESTOWY" na Zebrze/desktopie (public/shared/auth.js),
# zeby nie pomylic Maca z produkcja. Ustaw WMS_TESTOWY=1 TYLKO na maszynie testowej.
# Produkcja: NIE ustawiaj (domyslnie brak paska).
# WMS_TESTOWY=1

# DATA ODCIECIA dokumentow do stref (services/gt-dokumenty.js) - USTAW NA DZIEN WDROZENIA.
# Dokumenty starsze nie licza sie do dostaw/zwrotow/przywozek "do rozlozenia".
#
# Po co: przed wdrozeniem palety byly rozkladane poza nowym obiegiem (MM w Subiekcie albo
# dwukrok /lok -> /mm), wiec nie maja podpisu dokumentem i dla naszego rachunku wygladaja na
# nierozlozone. Pomiar 17.07.2026: bez odciecia 228 dostaw pokazuje sie jako widmo, kazde
# zjadajac CALY stan K4 i wypychajac polke do zera (np. NERCHIELIT10: "rozloz 2822" przy
# 2822 szt. na magazynie, polka 0).
#
# PUSTE / brak = BRAK ODCIECIA (widma widoczne). Tak jest domyslnie i celowo: zla data wygasza
# WSZYSTKIE listy po cichu, a widma sa przynajmniej widoczne. NIE USTAWIAJ DATY Z PRZYSZLOSCI -
# kazdy dokument jest od niej starszy, wiec dostawy/zwroty/przywozki beda puste (kod krzyczy
# o tym przy starcie).
#
# STALA WYGASA: okno dostaw to 90 dni, wiec ~90 dni po wdrozeniu mozna ja usunac razem
# z warunkiem w kodzie.
# WMS_DOKUMENTY_OD=

# Wyjatki od odciecia I od okna: numery dokumentow MAGAZYNOWYCH (PZ/PW/MM) jak w GT, po
# przecinku. Taki dokument liczy sie do stref bez wzgledu na date. Do pojedynczej palety,
# ktora naprawde stoi nierozlozona, a wypadla przed odcieciem - cofniecie samego odciecia
# wpuscilo by razem z nia wszystkie widma z tego okresu.
# Numer nieistniejacy w GT nic nie psuje (nic nie dopasuje). Po rozlozeniu palety wpis mozna
# usunac - dokument i tak schodzi z ekranow sam (pula jest capowana nieprzypisanym stanem K4).
# WMS_DOKUMENTY_WYJATKI=PZ 3123/2026

# Okno dla zwrotow i przywozek w dniach (domyslnie 14). Dostawy maja na sztywno 90 -
# to inne zjawisko: duze, rzadkie, FZ bywa starsza od przyjecia.
# WMS_OKNO_DROBNICA_DNI=14

# Backup bazy WMS (services/backup.js)
# WMS_BACKUP_MIRROR - drugie miejsce na kopie (drugi dysk / chmura / sciezka sieciowa).
#   Puste = tylko lokalnie (db/backups/). Ustaw przy wdrozeniu na Windows.
WMS_BACKUP_MIRROR=
# WMS_BACKUP_DIR - nadpisz katalog kopii (domyslnie db/backups/)
# WMS_BACKUP_DISABLED=1 - wylacz backup (np. w testach)

# Kopia poza maszyne / DR (services/backup-czytelne + rclone -> Backblaze B2). Patrz docs/backup-chmura.md.
#   Raz dziennie: paczka .db + 3 czytelne CSV (lokalizacje_zbiorczo / lokalizacje / historia)
#   wypychana rclone JEDNOKIERUNKOWO do chmury. Puste WMS_RCLONE_REMOTE = chmura wylaczona.
# WMS_RCLONE_REMOTE - remote:kubelek/prefiks, np. b2wms:kaziu-wms/wms  (WLACZA cala funkcje)
WMS_RCLONE_REMOTE=
# WMS_RCLONE_BIN - sciezka do rclone.exe, jesli nie w PATH (Windows: C:\was\bin\rclone.exe)
# WMS_RCLONE_CONFIG - sciezka do rclone.conf, jesli nie domyslna
# WMS_CHMURA_DIR - katalog paczek do wyslania (domyslnie db/backups/chmura/)
# WMS_CHMURA_TRZYMAJ_DNI - ile dni paczek trzymac LOKALNIE (domyslnie 14; chmura trzyma komplet)

# Auto-dopis skladnikow z rozmontowanych zestawow (RW zestawu + PW skladnikow).
# USTAW NA DZIEN WDROZENIA. Puste = job wylaczony (bezpieczny default).
WMS_ROZMONTOWANIA_OD=

# Zdjecia produktow na Zebrze (services/zdjecia.js) - API Sellasist, klucz = SKU.
# Puste = ekrany dzialaja jak dotad, tylko bez zdjec. Cache w db/zdjecia/ (poza repo).
SELLASIST_ACCOUNT=
SELLASIST_API_KEY=

# Repricer Empik (pricing/empik.js, platforma Mirakl). Klucz: panel sprzedawcy Empik -> menu uzytkownika
# -> "Klucz API". Puste = worker repricera pomija Empik. EMPIK_API_URL tylko do testow
# (https://stg1.marketplace.empik.com); domyslnie https://marketplace.empik.com.
EMPIK_API_KEY=
EMPIK_API_URL=

# Repricer Allegro (pricing/allegro.js) — WLASNA aplikacja "WMS Price" z https://apps.developer.allegro.pl/
# (typ: bez dostepu do przegladarki = device flow; uprawnienia: Oferty odczyt+zapis, Ustawienia sprzedazy odczyt).
# NIE aplikacja systemu Rozliczenia (tylko odczyt, a refresh token Allegro jest jednorazowy). Konta podpina
# `node pricing/allegro-autoryzuj.js EKAJTEK|NATROPIE` — tokeny ida do db/pricing.db, nie tutaj.
# Puste = worker repricera pomija Allegro.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# Nagłówek User-Agent (obowiązkowy w Allegro od 07.2026). Puste = WMS-Price/1.0 (+link do pricing/allegro.js) z generatora Allegro;
# ustaw, jeśli w aplikacji Allegro podano inną nazwę albo inny „Link do dokumentacji”.
ALLEGRO_USER_AGENT=
# Tylko dla aplikacji typu "z dostepem do przegladarki" (allegro-autoryzuj.js --przegladarka): adres przekierowania
# wpisany w aplikacji. Puste = http://localhost:8765/allegro/callback.
ALLEGRO_REDIRECT_URI=
# Allegro: wysylka cen z automatu. Automat da sie wlaczyc i liczy ceny, ale bez =1 niczego na Allegro nie wysyla
# (decyzja usera 2026-10-19: "automat, ale bez wysylki" do osobnej decyzji). Reczna cena z ekranu dziala zawsze.
PRICING_ALLEGRO_WYSYLKA=
# Raport "Czynniki Top oferty" (wgrywany z ekranu Ceny) — ile godzin repricer mu wierzy. Puste = 24.
PRICING_ALLEGRO_TOP_H=

# Niezbednik Sprzedawcy (pricing/niezbednik.js) — ceny konkurencji Allegro per EAN dla ofert z automatem.
# Klucz z panelu Niezbednika (konto OKITRADE). Puste = bez sprawdzen konkurencji. Ich repricera NIE uzywamy.
NIEZBEDNIK_API_KEY=
# Okno sprawdzen (godziny czasu polskiego, od-do) — w nocy bez sprawdzen. Puste = 7-23.
PRICING_NSP_OKNO=
# Najwyzej tyle sprawdzen (EAN) dziennie — chroni pakiet. Puste = 500.
PRICING_NSP_DZIENNIE=
# Ile godzin wynik sprawdzenia jest prawdziwy dla repricera (dluzej niz noc bez sprawdzen). Puste = 12.
PRICING_NSP_WAZNOSC_H=

# Analiza sprzedazy (docs/analiza-sprzedazy.md) — job WMS-Node dosypuje FS/ZK z GT do db/sprzedaz.db.
# Co ile minut biezacy przebieg (nocny idzie sam po 2:00). Puste = 15.
ANALIZA_INTERWAL_MIN=
# =1 wylacza job (np. lokalny WMS na kopii Z_KAJTEK, zeby nie mieszal danych w bazie modulu).
ANALIZA_WYLACZ=
# Sciezka bazy modulu. Puste = db/sprzedaz.db.
SPRZEDAZ_DB=
# Raport sprzedazy mailem (services/analiza-raport.js) — codziennie za wczoraj, w poniedzialek z tygodniem.
# Adresaci po przecinku. Puste = brak wysylki.
ANALIZA_RAPORT_DO=
# Od ktorej godziny wysylac (czas polski). Puste = 7.
ANALIZA_RAPORT_GODZINA=
# Gmail API tylko do wysylania (scope gmail.send): zgoda raz `node scripts/gmail-zgoda.js --klient <plik>`,
# potem `node scripts/sekrety.js zaszyfruj` (nazwy *CLIENT_ID / *SECRET / *TOKEN ida do .env.dpapi).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
